<header class="bg-blue-500 p-4">
  <nav class="container mx-auto flex justify-between items-center">
    <%= link_to 'Top', root_path, class: "text-white font-semibold" %>
    <div>
    <% if logged_in? %>
      <%= link_to notifications_path, class: "relative text-white mx-2" do %>
      <span>Notifications</span>
        <% if current_user.notifications.unread.count > 0 %>
          <span class="absolute top-0 right-0 inline-block w-6 h-6 bg-red-600 text-white text-xs leading-6 text-center rounded-full">
            <%= current_user.notifications.unread.count %>
          </span>
          <% end %>
           <% end %>
          <span class="text-white mx-2">
            <%= link_to current_user.email, user_path(id: current_user), class: "text-white mx-2" %>
            <%= button_to 'ログアウト', logout_path, method: "delete", class: "text-white mx-2 bg-transparent border-none cursor-pointer" %>
            <%= link_to '新規投稿', new_post_path, class: "text-white mx-2" %>
          </span>
        <% else %>
            <%= link_to 'Login', new_session_path, class: "text-white mx-2" %>
            <%= link_to 'Sign Up', new_user_path, class: "text-white mx-2" %>
        <% end %>
    </div>
  
  </nav>
</header>

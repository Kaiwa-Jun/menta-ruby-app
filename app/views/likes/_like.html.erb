<div id="like_button_<%= post.id %>">
  <% if logged_in? %>
    <% if post.liked_by?(current_user) %>
      <%= button_to 'Unlike', post_likes_path(post), method: :delete, remote: true, class: 'bg-red-500 text-white py-2 px-4 rounded-lg' %>
    <% else %>
      <%= button_to 'Like', post_likes_path(post), method: :post, remote: true, class: 'bg-blue-500 text-white py-2 px-4 rounded-lg' %>
    <% end %>
  <% end %>
</div>